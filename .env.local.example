# Copy to .env.local and fill in real values.

# HUD USER API token — free. Register at:
# https://www.huduser.gov/portal/dataset/fmr-api.html
# (Create an account, then create an access token.)
HUD_API_TOKEN=

# ATTOM Data API key — optional. Without it the app falls back to
# statewide tax estimates and HUD FMR only. Free trial at:
# https://api.developer.attomdata.com/
ATTOM_API_KEY=

# Mashvisor API key — optional, paid. Enables the Airbnb (STR) scenario
# and the Mashvisor data fidelity check. https://www.mashvisor.com/api-doc-v2
MASHVISOR_API_KEY=

# Auth — required. Session-signing secret (openssl rand -hex 32) and scrypt
# password hashes ("salthex:hashhex", N=16384 r=8 p=1 dklen=64) for the two
# hardcoded accounts luke.miller and bart.miller.
AUTH_SECRET=
AUTH_HASH_LUKE=
AUTH_HASH_BART=

# Neon Postgres (via Vercel Marketplace) — per-user pins/assumptions
# persistence. Without it the app runs with localStorage only.
DATABASE_URL=

# Census data API key — free, instant: api.census.gov/data/key_signup.html
# Enables county-level effective tax rates (ACS medians); statewide
# averages are the fallback. (The Census geocoder needs no key.)
CENSUS_API_KEY=

# --- Property-intelligence providers (PROP-23 epic; all optional — the
# --- app runs in demo mode with mock providers when keys are absent) ---
# RentCast: property records, listings, rent AVM + comps (primary)
RENTCAST_API_KEY=
# Regrid: address typeahead + parcel identity
REGRID_API_KEY=
# Future authorized MLS/RESO-compatible provider
MLS_PROVIDER_API_KEY=
# Explicit enable/disable overrides (default: enabled iff key present)
# ENABLE_RENTCAST=1
# ENABLE_ATTOM=1
# ENABLE_REGRID=1
# ENABLE_MLS=0
# Per-capability provider priority override, JSON (see lib/providers/registry.ts)
# PROVIDER_PRIORITY_JSON={"rental":["rentcast","attom","mock"]}
